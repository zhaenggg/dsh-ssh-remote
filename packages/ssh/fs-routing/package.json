{
  "name": "@zhaeng/dsh-fs-routing",
  "description": "Routing filesystem and subprocess providers: one dsh instance serving local and ssh:// remote workspaces",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaenggg/dsh-ssh-remote.git",
    "directory": "packages/ssh/fs-routing"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./route": {
      "types": "./lib/types/route.d.ts",
      "default": "./lib/route.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/route.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@zhaeng/dsh-ssh": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.2",
    "@zhaeng/dsh-fs-ssh": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.2",
    "@zhaeng/dsh-subprocess-ssh": "workspace:^",
    "@deepseek-ai/dsh-fs-sandbox": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "^0.1.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  }
}
