{
  "name": "@zhaeng/dsh-ssh",
  "description": "Shared SSH connection lifecycle for DeepSeek Harness remote-server adapters",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaenggg/dsh-ssh-remote.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./paths": {
      "types": "./lib/types/paths.d.ts",
      "default": "./lib/paths.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/paths.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/ssh2": "^1.15.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  }
}
